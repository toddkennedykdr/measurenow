GOOGLE_SOLAR_API_KEY=your_google_api_key_here
GOOGLE_MAPS_BROWSER_KEY=your_browser_restricted_maps_key_here
ROOF_API_KEY=
# Public geocode and quote calls per America/New_York day, all IPs combined.
# Over the cap those routes return 503 and do not call Google. Default 500.
ROOF_PUBLIC_DAILY_CAP=500
DATABASE_URL=postgresql://user:password@host:port/database
PORT=3001

# Required. Signs session cookies. No default.
SESSION_SECRET=

# JobNimbus. Prefer JN_API_KEY. JOBNIMBUS_API_KEY is an alias.
JN_API_KEY=
JOBNIMBUS_API_KEY=

# Optional. A staff user is seeded only when that variable is set.
SEED_TODD_PASSWORD=
SEED_ISAAC_PASSWORD=
SEED_ROB_PASSWORD=
