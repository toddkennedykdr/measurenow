GOOGLE_SOLAR_API_KEY=your_google_api_key_here
DATABASE_URL=postgresql://user:password@host:port/database
PORT=3001
# Used only when the users table is empty, to create the Todd admin account.
# If unset, startup skips seeding. Never commit a real value.
# SEED_ADMIN_PASSWORD=

# Customer estimate email. Sent only after the quote gate accepts a new lead.
# Off unless the value is exactly true. Unset, false, TRUE, and 1 all stay off.
# CUSTOMER_ESTIMATE_EMAIL_ENABLED=true
# House snapshot. Off unless the value is exactly true. Uses the existing
# GOOGLE_SOLAR_API_KEY for a server-side Google Static Maps satellite image.
# The key is not written into the email. A failed fetch omits the photo.
# ESTIMATE_EMAIL_SNAPSHOT_ENABLED=true
# Each value below is the confirmed default. Set it to empty to drop that block.
# CUSTOMER_EMAIL_FROM=K&D Roofing <noreply@kanddroofingnc.com>
# CUSTOMER_EMAIL_REPLY_TO=todd@kanddroofingnc.com
# CUSTOMER_EMAIL_CALENDLY_URL=https://calendly.com/admin-kanddroofingnc/30min
# CUSTOMER_EMAIL_CALENDLY_LABEL=Book your free inspection
# CUSTOMER_EMAIL_GC_LICENSE=NC General Contractor License L.101285 (Limited, Residential)
# CUSTOMER_EMAIL_MASTER_ELITE_TEXT=K&D Roofing is a 2026 GAF Master Elite® Roofing Contractor
# CUSTOMER_EMAIL_GAF_ID=1115371
# CUSTOMER_EMAIL_ASSET_BASE_URL=https://measurenow-production.up.railway.app
# CUSTOMER_EMAIL_LOGO_PATH=/static/kd-logo.png
# CUSTOMER_EMAIL_MASTER_ELITE_IMAGE_PATH=/static/master-elite-240.png
# Preview HTML from mock data (no send, no Google):
# npx tsx scripts/render-customer-estimate-email.ts /tmp/customer-estimate-email.html
# Local mock sink (stubbed Resend, JobNimbus, and Static Maps; no live calls):
# npm run build && node scripts/customer-estimate-email.test.mjs
